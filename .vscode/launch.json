    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "i2v validation",
            "type": "debugpy",
            "request": "launch",
            "program": "main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "+name=debug_i2v_validation",
                "debug=True",
                "algorithm=cogvideox_i2v",
                "dataset=bridge",
                "experiment=exp_video",
                "experiment.tasks=[validation]",
            ]
        },
        {
            "name": "i2v training",
            "type": "debugpy",
            "request": "launch",
            "program": "main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "+name=debug_i2v_training",
                "debug=True",
                "algorithm=cogvideox_i2v",
                "dataset=bridge",
                "experiment=exp_video",
                "experiment.tasks=[training]",
            ]
        },
        {
            "name": "vae validation",
            "type": "debugpy",
            "request": "launch",
            "program": "main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "+name=debug_vae_validation",
                "debug=True",
                "algorithm=cogvideox_vae",
                "dataset=bridge",
